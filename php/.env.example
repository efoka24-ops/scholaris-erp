APP_NAME=SCHOLARIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Douala

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En local : SQLite (aucun serveur a installer).
# En production sur Camoo : mysql, avec les identifiants crees dans cPanel.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=trugro9159_scholaris
# DB_USERNAME=trugro9159_scholaris
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# L'hebergement mutualise ne fait pas tourner de worker permanent : les jobs
# sont traites en synchrone, ou via une tache cron cPanel (queue:work --stop-when-empty).
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@trugroup.cm"
MAIL_FROM_NAME="${APP_NAME}"

# Comptes crees par les seeders. A surcharger en production.
SEED_TENANT_CODE=DEMO
SEED_TENANT_NAME="Etablissement Demo"
SEED_SUPER_ADMIN_EMAIL=admin@scholaris.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Passerelles de paiement Mobile Money (voir module payments-gateway).
PAYMENT_GATEWAY=camoo
CAMOO_API_KEY=
CAMOO_API_SECRET=
APISUNGKU_API_KEY=
APISUNGKU_API_SECRET=
