# ═══════════════════════════════════════════════════════════════════════════
# SCHOLARIS ERP — Variables du projet WEB sur VERCEL
# À saisir dans : Vercel → projet du frontend → Settings → Environment Variables
# (portée : Production, Preview, Development selon besoin).
# ═══════════════════════════════════════════════════════════════════════════

# URL de l'API NestJS sur Railway, AVEC le préfixe /api et SANS slash final.
# ⚠️ C'est LA variable qui, mal renseignée, provoque "Erreur de connexion au serveur".
# Utilisée uniquement côté serveur (proxy Route Handler) — pas exposée au navigateur.
NEST_API_URL=https://TON-API.up.railway.app/api

# Code de l'établissement par défaut affiché sur la page vitrine publique.
NEXT_PUBLIC_TENANT_CODE=DEMO
