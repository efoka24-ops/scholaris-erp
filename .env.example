APP_NAME=SCHOLARIS
APP_ENV=local
APP_DEBUG=true
# Clé de chiffrement des secrets (TOTP, données de santé) : 32 octets en base64, propre à chaque environnement.
# Générer avec : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
LOG_PATH=storage/logs/app.log

# Base de données : MySQL 8 (recette et production), SQLite pour les tests.
# Ne jamais commiter de valeurs réelles : le fichier .env est ignoré par git.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scholaris
DB_USERNAME=
DB_PASSWORD=

# Ports d'intégration (simulateurs en local et en recette)
# SMS_GATEWAY=log (journal) ou http (passerelle HTTP générique, effective seulement si SMS_HTTP_URL est renseignée).
SMS_GATEWAY=log
PAYMENT_GATEWAY=simulator
PDF_RENDERER=dompdf

# E-mail transactionnel (SMTP). Le mot de passe se renseigne uniquement dans le .env local ou du serveur.
# MAIL_MAILER=log (journal, aucun envoi) ou smtp ; smtp n'est effectif que si MAIL_HOST est renseigné.
# MAIL_ENCRYPTION : tls (STARTTLS, port 587), ssl (port 465) ou none (boucle locale uniquement).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=SCHOLARIS

# Passerelle SMS HTTP générique (HTTPS obligatoire). Le jeton ne se renseigne que dans le .env local ou du serveur.
# SMS_HTTP_HEADERS et SMS_HTTP_BODY : objets JSON ; dans le corps, {{to}}, {{message}} et {{sender}} sont remplacés.
# SMS_HTTP_REFERENCE_PATH : chemin pointé de la référence du message dans la réponse JSON (ex. data.id).
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_TOKEN=
SMS_HTTP_TOKEN_HEADER=Authorization
SMS_HTTP_TOKEN_PREFIX="Bearer "
SMS_HTTP_HEADERS=
SMS_HTTP_BODY=
SMS_HTTP_SENDER=
SMS_HTTP_REFERENCE_PATH=

# Passerelle mobile money Sungku (Orange Money, MTN MoMo). Clé et secret propres à CE projet :
# à renseigner uniquement dans le .env local ou du serveur, jamais dans le dépôt.
SUNGKU_BASE_URL=https://sungku.trugroup.cm
SUNGKU_API_KEY=
SUNGKU_WEBHOOK_SECRET=

# Double authentification des rôles sensibles (true par défaut ; false = mot de passe seul)
AUTH_2FA_REQUIRED=true

# Contact et numéros de paiement de la plateforme (TRU GROUP) montrés aux établissements sur l'écran de régularisation.
# Se règlent dans le back-office (Réglages > Contact et numéros de paiement) ; ces variables ne servent que de repli si le réglage est vide.
PLATFORM_CONTACT_NAME="TRU GROUP"
PLATFORM_CONTACT_EMAIL=
PLATFORM_CONTACT_PHONE=
# Numéros de paiement mobile money (format +2376XXXXXXXX) et nom du bénéficiaire
PLATFORM_PAY_ORANGE_PHONE=
PLATFORM_PAY_ORANGE_HOLDER=
PLATFORM_PAY_MTN_PHONE=
PLATFORM_PAY_MTN_HOLDER=
