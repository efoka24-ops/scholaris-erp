# ═══════════════════════════════════════════════════════════════════════════
# SCHOLARIS ERP — Variables du service API sur RAILWAY
# À saisir dans : Railway → service de l'API → onglet Variables (Raw Editor).
# ⚠️ Ne colle jamais une valeur avec un espace/tabulation en début ou fin.
# ⚠️ Les secrets (mots de passe, clés) ne doivent exister QUE sur Railway,
#    jamais commités dans le repo.
# ═══════════════════════════════════════════════════════════════════════════

# --- Base de données (plugin PostgreSQL de Railway) -------------------------
# Utilise la référence Railway pour ne pas recopier l'URL à la main :
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Environnement ----------------------------------------------------------
NODE_ENV=production
# NE PAS définir PORT : Railway l'injecte automatiquement et l'API écoute dessus.

# --- JWT (obligatoires — génère chaque secret avec: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=CHANGEME_secret_access_64_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGEME_secret_refresh_64_hex
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend / liens ------------------------------------------------------
# Domaine public du frontend Vercel (sans slash final).
CORS_ORIGIN=https://TON-APP.vercel.app
# Utilisé pour construire les liens dans les emails (page de connexion).
APP_PUBLIC_URL=https://TON-APP.vercel.app
# Adresse de support affichée dans les emails d'identifiants.
SUPPORT_EMAIL=scholaris-erp@trugroup.cm

# --- EMAIL sur Railway : OBLIGATOIREMENT Brevo (API HTTP, port 443) ----------
# Le SMTP direct est BLOQUÉ par Railway (tous ports timeout) — n'y compte pas ici.
# Clé API v3 Brevo (commence par "xkeysib-"), onglet API Keys (PAS l'onglet SMTP).
BREVO_API_KEY=CHANGEME_xkeysib-...
# Expéditeur : DOIT être un sender "Verified" dans Brevo (ou domaine authentifié).
SMTP_FROM_EMAIL=scholaris-erp@trugroup.cm
SMTP_FROM_NAME=scholaris ERP
# ⛔ NE définis PAS SMTP_HOST/SMTP_USER/SMTP_PASSWORD sur Railway : inutiles
#    (bloqués) et ils seraient de toute façon ignorés tant que BREVO_API_KEY est là.

# --- Paiement CAMOO (optionnel — laisse vide si non utilisé) -----------------
CAMOO_BASE_URL=https://api.camoo.cm/v1/payment
CAMOO_API_KEY=CHANGEME_cle_marchand_camoo
CAMOO_API_SECRET=CHANGEME_secret_marchand_camoo

# --- Uploads (stockage local des fichiers générés) --------------------------
UPLOADS_DIR=/app/uploads

# --- SMS / WhatsApp (optionnels — Module 8) ---------------------------------
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
