APP_NAME=SCHOLARIS
APP_ENV=local
APP_URL=http://localhost:8000

# Mettre a 1 en production quand le certificat HTTPS est en place : le cookie
# de session n'est alors plus transmis en clair.
SESSION_SECURE=0

# sqlite en developpement (aucun serveur a installer), mysql en production.
DB_CONNECTION=sqlite
DB_DATABASE=database/scholaris.sqlite

# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=trugro9159_scholariserp
# DB_USERNAME=trugro9159_norep
# DB_PASSWORD=

SEED_TENANT_CODE=DEMO
SEED_TENANT_NAME=Etablissement Demo
SEED_SUPER_ADMIN_EMAIL=admin@scholaris.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- Passerelle Mobile Money pawaPay -------------------------------------
# sandbox tant que les paiements ne sont pas reels. Les jetons different
# entre bac a sable et production.
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_API_TOKEN=

# Operateurs proposes, au format CODE=Libelle separes par des virgules.
# Les codes exacts dependent du compte : "artisan pawapay" les liste.
PAWAPAY_PROVIDERS=MTN_MOMO_CMR=MTN Mobile Money,ORANGE_CMR=Orange Money

# Cle publique de verification des callbacks. Laissee vide, elle est
# recuperee automatiquement aupres de pawaPay.
PAWAPAY_PUBLIC_KEY=
